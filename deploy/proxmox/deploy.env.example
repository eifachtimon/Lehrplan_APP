# Kopieren nach deploy.env und anpassen:
#   cp deploy/proxmox/deploy.env.example deploy/proxmox/deploy.env

# Absoluter Pfad zum Repo auf der VM
APP_ROOT=/opt/lehrplan/Lehrplan_APP

# Linux-User, der den Dienst ausführt (muss APP_ROOT besitzen dürfen)
APP_USER=lehrplan

# Eine Domain für UI + API (Nginx proxyt /search, /health, … an Gunicorn)
DOMAIN=lehrplan.example.com

# https://DOMAIN — bei reinem HTTP lokal: http://DOMAIN
PUBLIC_URL=https://lehrplan.example.com

# Komma-getrennt; bei einer Domain reicht PUBLIC_URL
CORS_ORIGINS=https://lehrplan.example.com
